# VIGIROAD — modèle de configuration.
# Copier vers config/<env>.env puis compiler avec :
#   flutter run --dart-define-from-file=config/dev.env
# Ne jamais committer de clé secrète : les fichiers config/*.local.env sont ignorés par git.

# Environnement : dev | test | prod
VR_ENV=dev

# Style de carte MapLibre (JSON). Par défaut : CARTO Dark Matter (données OpenStreetMap).
VR_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Calcul d'itinéraires compatible OSRM. Le serveur public de démonstration ne
# convient pas à la production : prévoir une instance auto-hébergée.
VR_ROUTING_URL=https://router.project-osrm.org

# Géocodage / recherche d'adresses compatible Photon.
VR_GEOCODING_URL=https://photon.komoot.io

# Source distante optionnelle de la liste de plaques (HTTPS, CSV ou JSON). Vide = désactivée.
VR_PLATES_SYNC_URL=

# Serveur de trafic VigiRoadTrafficAggregator (voir server/README.md). Vide = trafic
# désactivé. La clé est fournie en CI par les secrets VR_TRAFFIC_API_URL / VR_TRAFFIC_API_KEY.
VR_TRAFFIC_API_URL=
VR_TRAFFIC_API_KEY=

# Identifiant de l'application auprès des services OpenStreetMap (obligatoire).
VR_USER_AGENT="VIGIROAD/1.0 (+https://github.com/hempreur/VIGIROAD)"
